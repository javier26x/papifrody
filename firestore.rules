rules_version = '2';

// frody.body — cada usuario solo puede leer/escribir SUS propios datos.
// Estructura:
//   users/{uid}                      -> (sin campos relevantes, contenedor)
//   users/{uid}/days/{YYYY-MM-DD}    -> un documento por día
//   users/{uid}/meta/profile         -> { startWeight, goal }
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Validación ligera de un documento de día.
    function validDay(d) {
      return d.keys().hasOnly([
        'weight','waist','injected','gi','protein','water','sleep',
        'sunAM','bike','strength','cleanFood','noLiquidSugar','stressOK',
        'supps','notes','updatedAt'
      ])
      && (d.gi is number ? (d.gi >= 0 && d.gi <= 10) : true)
      && (d.protein is number ? d.protein >= 0 : true)
      && (d.water is number ? d.water >= 0 : true)
      && (d.notes is string ? d.notes.size() <= 4000 : true);
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /days/{date} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && validDay(request.resource.data);
      }

      match /meta/{docId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
